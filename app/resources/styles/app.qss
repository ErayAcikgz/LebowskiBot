/* Lebowski palette: application background #181C22, primary #222831,
   secondary #393E46, muted accent #948979, light accent #DFD0B8. */

QWidget {
    background-color: #181C22;
    color: #DFD0B8;
    font-family: "DejaVu Sans";
    font-size: 13px;
}

#topBar {
    background-color: #393E46;
    border-bottom: 1px solid #948979;
}

#applicationName {
    color: #DFD0B8;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 2px;
}

#connectionIndicator {
    background-color: #948979;
    border-radius: 4px;
}

#connectionStatus {
    color: #948979;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

#estopStatus {
    background-color: #3a1e20;
    border: 1px solid #a34b4c;
    color: #f07e7e;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 7px 12px;
}

#navigationPanel {
    background-color: #222831;
    border-right: 1px solid #948979;
}

#navigationSection {
    color: #948979;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
    padding-left: 12px;
}

#navigationButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    color: #948979;
    padding: 0 14px;
    text-align: left;
}

#navigationButton:hover {
    background-color: #393E46;
    color: #DFD0B8;
}

#navigationButton:checked {
    background-color: #393E46;
    border-left: 3px solid #DFD0B8;
    color: #DFD0B8;
    padding-left: 11px;
}

#pageStack {
    background-color: #181C22;
}

#pageTitle {
    color: #DFD0B8;
    font-size: 29px;
    font-weight: 600;
}

#pageDescription {
    color: #948979;
    font-size: 14px;
}

#overviewPanel {
    background-color: #393E46;
    border: 1px solid #5b554d;
    border-radius: 6px;
}

#panelTitle {
    color: #948979;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
}

#panelDivider {
    background-color: #514d47;
    border: none;
}

#statusIndicator {
    min-height: 24px;
}

#statusDot {
    background-color: #948979;
    border-radius: 4px;
}

#statusIndicator[tone="safety"] #statusDot {
    background-color: #DFD0B8;
}

#statusText {
    color: #DFD0B8;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
}

#safetyLabel {
    color: #948979;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    margin-top: 8px;
}

#valueRow {
    min-height: 24px;
}

#valueLabel {
    color: #948979;
}

#valueText {
    color: #DFD0B8;
    font-weight: 600;
}

#jointLabel {
    color: #948979;
    font-family: monospace;
    font-weight: 700;
}

#jointValue {
    color: #DFD0B8;
    font-family: monospace;
    font-weight: 600;
}

#controlSlider {
    min-height: 20px;
}

#controlSlider::groove:horizontal {
    height: 4px;
    background-color: #514d47;
}

#controlSlider::handle:horizontal {
    width: 12px;
    margin: -5px 0;
    background-color: #DFD0B8;
    border: 1px solid #948979;
    border-radius: 6px;
}

#controlSlider::sub-page:horizontal {
    background-color: #948979;
}

#controlValue {
    color: #DFD0B8;
    font-family: monospace;
    font-weight: 600;
}

#jointInput {
    background-color: #222831;
    border: 1px solid #948979;
    border-radius: 3px;
    color: #DFD0B8;
    font-family: monospace;
    font-weight: 600;
    padding: 3px 6px;
}

#jointInput:focus {
    border-color: #DFD0B8;
}

#stepSelector {
    background-color: #222831;
    border: 1px solid #948979;
    border-radius: 3px;
    color: #DFD0B8;
    padding: 4px 8px;
}

#stepSelector::drop-down {
    border: none;
    width: 20px;
}

#stepSelector QAbstractItemView {
    background-color: #222831;
    border: 1px solid #948979;
    color: #DFD0B8;
    selection-background-color: #393E46;
}

#jogButton {
    background-color: #222831;
    border: 1px solid #948979;
    border-radius: 3px;
    color: #DFD0B8;
    font-size: 15px;
    font-weight: 700;
    padding: 0;
}

#jogButton:hover {
    background-color: #514d47;
}

#jogButton:pressed {
    background-color: #393E46;
}

#secondaryButton,
#stopButton {
    border: 1px solid #948979;
    border-radius: 3px;
    color: #DFD0B8;
    font-weight: 700;
    padding: 0 16px;
}

#secondaryButton {
    background-color: #222831;
}

#secondaryButton:hover {
    background-color: #514d47;
}

#programList,
#instructionList {
    background-color: #222831;
    border: 1px solid #514d47;
    border-radius: 3px;
    color: #DFD0B8;
    outline: none;
}

#programList::item,
#instructionList::item {
    border-bottom: 1px solid #393E46;
    padding: 7px 8px;
}

#programList::item:hover,
#instructionList::item:hover {
    background-color: #393E46;
}

#programList::item:selected,
#instructionList::item:selected {
    background-color: #514d47;
    color: #DFD0B8;
}

#programName {
    color: #DFD0B8;
    font-size: 18px;
    font-weight: 600;
}

#instructionHeading {
    color: #DFD0B8;
    font-family: monospace;
    font-weight: 700;
}

#instructionSection {
    color: #948979;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

#instructionSpin,
#instructionSelector {
    background-color: #222831;
    border: 1px solid #948979;
    border-radius: 3px;
    color: #DFD0B8;
    padding: 3px 6px;
}

#instructionSpin:focus,
#instructionSelector:focus {
    border-color: #DFD0B8;
}

#instructionSelector QAbstractItemView {
    background-color: #222831;
    border: 1px solid #948979;
    color: #DFD0B8;
    selection-background-color: #393E46;
}

#instructionInput {
    background-color: #222831;
    border: 1px solid #948979;
    border-radius: 3px;
    color: #DFD0B8;
    padding: 5px 7px;
}

#instructionInput:disabled {
    border-color: #514d47;
    color: #948979;
}

#programStatus {
    color: #948979;
    font-size: 11px;
}

#stopButton {
    background-color: #3a1e20;
    border-color: #a34b4c;
    color: #f07e7e;
}

#stopButton:hover {
    background-color: #51272a;
}

#robotView {
    background-color: #222831;
    border: 1px dashed #948979;
}

#robotViewTitle {
    color: #DFD0B8;
    font-size: 14px;
    font-weight: 600;
}

#robotViewStatus {
    color: #948979;
    font-size: 12px;
}

#bottomStatusBar {
    background-color: #393E46;
    border-top: 1px solid #948979;
    color: #948979;
    font-size: 11px;
}

#robotStatus {
    color: #DFD0B8;
    font-weight: 600;
}

#jointStatus {
    color: #948979;
    font-family: monospace;
}
